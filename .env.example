# Copy to .env and fill in what you need. Every value is optional; the demo runs with none of them.

# FalkorDB: docker compose sets this automatically (redis://falkordb:6379).
# For FalkorDB Cloud use: redis://default:PASSWORD@HOST:PORT
# For running Python directly on host machine: redis://localhost:6379
# FALKORDB_URL=redis://localhost:6379

# Where the dashboard is reachable (used in GitHub status links and to allow MCP over HTTP from that host)
PUBLIC_URL=http://localhost:8000

# Gemini (free key from https://aistudio.google.com/apikey). Without it, LLM mode is simply disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_MODE=rules

# GitHub. For the Home Assistant workspace a token only raises the read rate limit (60 -> 5,000 requests
# per hour) and gives real PR titles; it is used for reads only. For the Acme sample's PR comments: a
# fine-grained token for the demo repo with "Pull requests" and "Commit statuses" Read and write.
# GITHUB_REPO is owner/name, e.g. yourname/acme-payments-demo
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# The PR numbers of the three demo PRs in your demo repo (change if your repo already had issues/PRs)
PR_TOKEN_VERIFY=1
PR_SESSION_REFRESH=2
PR_JWKS=3

# Embeddings: auto (fastembed if the model can be downloaded, else the built-in hashing embedder) | fastembed | hash
EMBED_BACKEND=auto

# Protect the "Reset demo" endpoint on a public deployment
ADMIN_TOKEN=

# Extra hostnames allowed to call /mcp over HTTP (comma separated), or * to allow any
MCP_ALLOWED_HOSTS=

# Only when the dashboard is hosted on another domain (e.g. Vercel): its origin, comma separated. Default *
CORS_ORIGINS=*

# ---- Home Assistant workspace (read-only; never posts to GitHub). See docs/HOME_ASSISTANT.md
TENANTS=ha,acme,globex
# Snapshot file (default: data/ha_snapshot.json.gz in the repo)
HA_SNAPSHOT=
# Where PRs come from: auto (git when HA_CLONE is set, else the GitHub API) | git | github
HA_SOURCE=auto
# Path to a clone of https://github.com/home-assistant/core (only for HA_SOURCE=git; a shallow clone is fine)
HA_CLONE=
# Live feed: check new open PRs every HA_FEED_INTERVAL seconds (minimum 60), HA_FEED_BATCH per poll
HA_FEED=0
HA_FEED_INTERVAL=180
HA_FEED_BATCH=12
